---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { getPostHomeContent } from "../../../utils/post-card-content";
import { getFileDirFromPath, getPostUrl, getTagUrl, getCategoryUrl } from "../../../utils/url-utils";
import { formatDateToYYYYMMDD } from "../../../utils/date-utils";
import Image from "../../atoms/Image/Image.astro";
import type { PostCardProps } from "./types";

const { entry, style }: PostCardProps = Astro.props as PostCardProps;
const { title, published, tags, category, image, pinned, encrypted, password } = entry.data;
const postUrl = getPostUrl(entry);
const { remarkPluginFrontmatter } = await render(entry);
const homeContent = getPostHomeContent(entry.data, remarkPluginFrontmatter.excerpt);
---

<article class:list={["glass-panel glass-post-card", Astro.props.class]} style={style}>
	{image && <a href={postUrl} class="glass-post-cover" aria-label={title}><Image src={image} basePath={getFileDirFromPath(entry.filePath || "")} alt={title} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 50vw" /></a>}
	<div class="glass-post-meta">
		<time datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>
		<span aria-hidden="true">/</span>
		{category && <a href={getCategoryUrl(category)}>{category}</a>}
		{pinned && <span><Icon name="mdi:pin" />置顶</span>}
	</div>
	<h3><a href={postUrl}>{encrypted && password && <Icon name="material-symbols:lock-outline" />}{title}</a></h3>
	<p>{homeContent}</p>
	<div class="glass-post-bottom">
		<div class="glass-post-tags">{tags?.slice(0, 3).map(tag => <a href={getTagUrl(tag)}># {tag.trim()}</a>)}</div>
		<a class="glass-post-arrow" href={postUrl} aria-label={`阅读：${title}`}><Icon name="material-symbols:arrow-forward-rounded" /></a>
	</div>
</article>
