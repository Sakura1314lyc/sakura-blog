---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../../config";
import ThemeSwitch from "../../control/ThemeSwitch.svelte";
import Search from "../../organisms/navigation/Search.svelte";
import { url } from "../../../utils/url-utils";

const pages = [
	{ title: "首页", href: "/", icon: "material-symbols:home-outline-rounded" },
	{ title: "归档", href: "/archive/", icon: "material-symbols:inventory-2-outline-rounded" },
	{ title: "项目", href: "/projects/", icon: "material-symbols:code-rounded", enabled: siteConfig.featurePages.projects },
	{ title: "相册", href: "/albums/", icon: "material-symbols:photo-library-outline-rounded", enabled: siteConfig.featurePages.albums },
	{ title: "日记", href: "/diary/", icon: "material-symbols:edit-note-rounded", enabled: siteConfig.featurePages.diary },
	{ title: "友链", href: "/friends/", icon: "material-symbols:link-rounded", enabled: siteConfig.featurePages.friends },
	{ title: "关于", href: "/about/", icon: "material-symbols:person-outline-rounded" },
].filter(page => page.enabled !== false);
const morePages = [
	{ title: "追番", href: "/anime/", enabled: siteConfig.featurePages.anime },
	{ title: "设备", href: "/devices/", enabled: siteConfig.featurePages.devices },
	{ title: "技能", href: "/skills/", enabled: siteConfig.featurePages.skills },
	{ title: "时间线", href: "/timeline/", enabled: siteConfig.featurePages.timeline },
].filter(page => page.enabled);
---

<a class="glass-skip-link" href="#content-wrapper">跳到主要内容</a>
<header id="navbar-wrapper" class="glass-header">
	<div id="navbar" class="glass-navbar" data-transparent-mode="semi">
		<a class="glass-brand" href={url("/")} aria-label={`${profileConfig.name} 首页`}>
			<Icon name="mdi:flower-tulip-outline" />
			<span>{profileConfig.name}<b>の</b><span class="glass-brand-tail">小小世界</span></span>
		</a>
		<nav class="glass-desktop-nav" aria-label="主导航">
			{pages.map(page => <a href={url(page.href)} data-glass-nav aria-current={Astro.url.pathname === page.href ? "page" : undefined}>{page.title}</a>)}
			<details class="glass-more">
				<summary>更多 <Icon name="material-symbols:expand-more-rounded" /></summary>
				<div class="glass-nav-popup">
					{morePages.map(page => <a href={url(page.href)} data-glass-nav aria-current={Astro.url.pathname === page.href ? "page" : undefined}>{page.title}</a>)}
					<a href="https://github.com/Sakura1314lyc" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
				</div>
			</details>
		</nav>
		<div class="glass-nav-actions">
			<Search client:only="svelte" />
			<ThemeSwitch client:load />
			<details class="glass-mobile-menu">
				<summary aria-label="打开导航菜单"><Icon name="material-symbols:menu-rounded" /></summary>
				<nav class="glass-nav-popup" aria-label="移动端导航">
						{pages.map(page => <a href={url(page.href)} data-glass-nav aria-current={Astro.url.pathname === page.href ? "page" : undefined}><Icon name={page.icon} />{page.title}</a>)}
						{morePages.map(page => <a href={url(page.href)} data-glass-nav aria-current={Astro.url.pathname === page.href ? "page" : undefined}>{page.title}</a>)}
				</nav>
			</details>
		</div>
	</div>
</header>

{import.meta.env.PROD && <script is:inline define:vars={{ scriptUrl: url("/pagefind/pagefind.js") }}>
	// Navigation persists across Swup visits, as does this lazy search index.
	let pagefindLoading;
	window.loadPagefind = async function() {
		if (window.pagefind) return;
		if (pagefindLoading) return pagefindLoading;
		pagefindLoading = (async () => {
			try {
				const pagefind = await import(scriptUrl);
				await pagefind.options({ excerptLength: 20 });
				window.pagefind = pagefind;
				document.dispatchEvent(new CustomEvent("pagefindready"));
			} catch (error) {
				console.error("Failed to load Pagefind:", error);
				document.dispatchEvent(new CustomEvent("pagefindloaderror"));
			} finally {
				pagefindLoading = undefined;
			}
		})();
		return pagefindLoading;
	};
</script>}

<script>
	function syncNavigation() {
		for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-glass-nav]")) {
			if (new URL(link.href).pathname === location.pathname) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		}
		for (const menu of document.querySelectorAll<HTMLDetailsElement>(".glass-header details")) menu.open = false;
	}
	document.addEventListener("click", event => {
		const target = event.target as Element;
		for (const menu of document.querySelectorAll<HTMLDetailsElement>(".glass-header details[open]")) {
			if (!menu.contains(target) || target.closest("a")) menu.open = false;
		}
	});
	document.addEventListener("keydown", event => {
		if (event.key === "Escape") {
			for (const menu of document.querySelectorAll<HTMLDetailsElement>(".glass-header details[open]")) {
				menu.open = false;
				menu.querySelector("summary")?.focus();
			}
		}
	});
	const attach = () => window.swup?.hooks.on("page:view", syncNavigation);
	if (window.swup) attach();
	else document.addEventListener("swup:enable", attach, { once: true });
</script>
