---
import type { MarkdownHeading } from "astro";
import FloatingControls from "@components/control/FloatingControls.astro";
import GlassNavigation from "@components/features/glass/GlassNavigation.astro";
import GlassSidebar from "@components/features/glass/GlassSidebar.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Footer from "@components/organisms/footer/Footer.astro";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	coverImage?: string;
	publishedDate?: Date;
	category?: string;
	wordCount?: number;
}

const { title, banner, description, lang, setOGTypeArticle, postSlug,
	coverImage, headings = [], publishedDate, category, wordCount } = Astro.props;
const isHomePage = Astro.url.pathname === "/";
const isPostList = isHomePage || /^\/\d+\/?$/.test(Astro.url.pathname);
---

<Layout {title} {banner} {description} {lang} {setOGTypeArticle} {postSlug} {coverImage}>
	<slot slot="head" name="head" />
	<div class="glass-scenery" aria-hidden="true"></div>
	<IconifyLoader />
	<GlassNavigation />
	<main id="swup-container" class="glass-main transition-swup-fade">
		<div id="main-grid" class:list={["glass-layout", { "glass-layout-wide": isPostList }]}>
			<div id="content-wrapper" class="glass-content transition-leaving">
				<div id="page-overlay-data" class="hidden" data-title={title || ""}
					data-date={publishedDate ? formatDateToYYYYMMDD(publishedDate) : ""}
					data-category={category || ""} data-words={wordCount ? String(wordCount) : ""}
					data-is-post={postSlug ? "true" : "false"} data-is-home={isHomePage ? "true" : "false"}
					data-wallpaper-mode="none"></div>
				<slot />
			</div>
			{!isPostList && <GlassSidebar headings={headings} />}
		</div>
		<div class="glass-footer"><Footer /></div>
		<FloatingControls headings={headings} />
	</main>
</Layout>
